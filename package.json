{
  "name": "aissentials-clickhouse-drilldown-app",
  "version": "1.0.0",
  "description": "Queryless browsing of OpenTelemetry metrics, logs and traces stored in ClickHouse",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "prettier:check": "prettier --check --list-different=false --log-level=warn \"**/*.{ts,tsx,md,json,js,mjs}\"",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,md,json}\"",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "sign": "npx --package=@grafana/sign-plugin@4.0.0 -- sign-plugin"
  },
  "author": "AIssentials",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "8.2.0",
    "@grafana/tsconfig": "2.2.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/glob": "8.1.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/node": "24.13.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack-livereload-plugin": "2.3.6",
    "@typescript-eslint/eslint-plugin": "8.62.0",
    "@typescript-eslint/parser": "8.62.0",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.0.1",
    "css-loader": "7.1.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.0.13",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-webpack-plugin": "6.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.9.3",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.101.0",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.108.2",
    "webpack-cli": "7.1.0",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-merge": "6.0.1",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.1.1",
    "@grafana/i18n": "13.1.1",
    "@grafana/runtime": "13.1.1",
    "@grafana/scenes": "8.22.0",
    "@grafana/schema": "13.1.1",
    "@grafana/ui": "13.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "react-router": "6.30.4"
  }
}
