{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "AIssentials ClickHouse Drilldown",
  "id": "aissentials-clickhousedrilldown-app",
  "autoEnabled": true,
  "info": {
    "description": "Queryless browsing of OpenTelemetry metrics, logs and traces stored in ClickHouse",
    "author": { "name": "AIssentials" },
    "keywords": ["clickhouse", "opentelemetry", "drilldown", "metrics", "logs", "traces"],
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "links": [
      { "name": "Website", "url": "https://github.com/OneCyrus/aissentials-clickhouse-drilldown-app" },
      { "name": "Issues", "url": "https://github.com/OneCyrus/aissentials-clickhouse-drilldown-app/issues" },
      { "name": "License", "url": "https://github.com/OneCyrus/aissentials-clickhouse-drilldown-app/blob/main/LICENSE" }
    ],
    "screenshots": [
      { "name": "Metrics overview", "path": "img/screenshots/metrics-overview.png" },
      { "name": "Metric with heatmap and breakdown", "path": "img/screenshots/metrics-heatmap.png" },
      { "name": "Logs by service", "path": "img/screenshots/logs-services.png" },
      { "name": "Logs of a service", "path": "img/screenshots/logs-service.png" },
      { "name": "Traces overview", "path": "img/screenshots/traces-overview.png" },
      { "name": "Trace duration breakdown", "path": "img/screenshots/traces-duration.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Metrics (ClickHouse)",
      "path": "/a/aissentials-clickhousedrilldown-app/metrics",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Logs (ClickHouse)",
      "path": "/a/aissentials-clickhousedrilldown-app/logs",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Traces (ClickHouse)",
      "path": "/a/aissentials-clickhousedrilldown-app/traces",
      "addToNav": true
    }
  ],
  "extensions": {
    "addedLinks": [
      {
        "targets": ["grafana/dashboard/panel/menu", "grafana/explore/toolbar/action"],
        "title": "Open in AIssentials ClickHouse Drilldown",
        "description": "Browse the data of this query in AIssentials ClickHouse Drilldown"
      }
    ]
  },
  "dependencies": {
    "grafanaDependency": ">=11.6.11",
    "plugins": [{ "id": "grafana-clickhouse-datasource", "type": "datasource", "name": "ClickHouse" }]
  }
}
